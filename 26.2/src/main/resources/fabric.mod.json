{
  "schemaVersion": 1,
  "id": "simpleplanes",
  "version": "${version}",

  "name": "Simple Planes",
  "description": "Adds upgradeable planes and helicopters.",
  "authors": [
    "SappyInsane"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/simple-planes",
    "sources": "https://github.com/unknown-wq/simple-planes"
  },

  "license": "LGPL-3.0-or-later",

  "environment": "*",
  "entrypoints": {
    "main": [
      "xyz.przemyk.simpleplanes.SimplePlanesMod"
    ],
    "client": [
      "xyz.przemyk.simpleplanes.client.SimplePlanesClient"
    ]
  },
  "accessWidener": "simpleplanes.accesswidener",
  "mixins": [
    "simpleplanes.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25"
